---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import arthurPicture from "../../assets/arthur.jpg";
---

<Layout
    title="Arthur Rodolfo"
    description="Software Engineer based in Vancouver, building products with care and precision">
    <section
        class="mx-auto max-w-3xl flex flex-col gap-8 lg:gap-12 min-h-[calc(100vh-12rem)] justify-center"
        aria-label="Arthur Rodolfo's introduction">
        <div class="flex flex-col lg:flex-row items-center lg:items-start gap-8">
            <Image
                class="w-32 h-32 lg:w-40 lg:h-40 rounded-full object-cover shadow-lg"
                src={arthurPicture}
                alt="Arthur Rodolfo"
                loading="eager"
            />

            <div class="flex-1 flex flex-col gap-4">
                <div>
                    <h1 class="text-4xl lg:text-5xl font-bold mb-2">
                        Arthur Rodolfo
                    </h1>
                    <p class="text-xl lg:text-2xl text-slate-600 dark:text-slate-400">
                        Software Engineer
                    </p>
                </div>

                <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
                    Hey! I'm a software engineer from Brazil <Icon
                        name="twemoji:flag-for-brazil"
                        class="inline-block h-5 w-5"
                    /> currently based in Vancouver <Icon
                        name="twemoji:flag-for-canada"
                        class="inline-block h-5 w-5"
                    />. I build web applications with a focus on clean code and great user experiences, leveraging AI tools to ship faster.
                </p>

                <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
                    Right now, I'm working at <a href="https://www.clio.com/" target="_blank" rel="noopener noreferrer" class="font-medium underline decoration-2 underline-offset-2 hover:text-slate-900 dark:hover:text-white transition-colors">Clio</a> on the Platform Team, helping integrate products into a unified platform. Previously, I've worked with companies like Hubly, BTG Pactual, and others, building everything from e-commerce systems to financial monitoring tools.
                </p>

                <a 
                    href="mailto:arthurrodolfo81@gmail.com" 
                    class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-lg font-medium hover:bg-slate-700 dark:hover:bg-slate-200 transition-colors w-fit"
                >
                    <Icon name="mdi:email-outline" class="w-5 h-5" />
                    Let's chat
                </a>
            </div>
        </div>
    </section>
</Layout>
