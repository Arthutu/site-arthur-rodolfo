---
import Layout from "../../layouts/Layout.astro";
import ExperienceTile from "../../components/Experience/ExperienceTile.astro";
import ExperienceTileMobile from "../../components/Experience/ExperienceTileMobile.astro";
import Link from "../../components/Link.astro";
import OpenInNewTabIcon from "../../components/OpenInNewTabIcon.astro";

const experiences = [
    {
        role: "Software Engineer",
        company: "Clio",
        companyUrl: "https://www.clio.com/",
        description:
            "Working on the Platform Team to integrate Clio's products into a unified platform. Focused on improving both user and developer experience across the product suite.",
        from: "July 2025",
        to: "Present",
        skills: [
            "Ruby",
            "Ruby on Rails",
        ],
    },
    {
        role: "Software Engineer",
        company: "Hubly",
        companyUrl: "https://www.myhubly.com/",
        description:
            "Built features for conditional logic, dynamic forms, and a template marketplace using React and Django. Led code reviews and worked closely with product and support teams to ship features that users loved.",
        from: "July 2022",
        to: "June 2025",
        skills: [
            "React",
            "Django",
            "GraphQL",
            "Python",
            "JavaScript",
            "AWS RDS",
            "AWS Cognito",
            "AWS Lambda",
        ],
    },
    {
        role: "Software Engineer",
        company: "BTG Pactual",
        companyUrl: "https://www.btgpactual.com/us/",
        description:
            "Developed an internal tool for monitoring financial transactions with real-time traceability using AWS SQS and SNS. Led a UI/UX redesign using Angular and .NET to make the system more intuitive.",
        from: "Jan 2022",
        to: "July 2022",
        skills: [
            "Angular",
            ".NET",
            "TypeScript",
            "AWS SQS",
            "AWS SNS",
            "AWS Lambda",
        ],
    },
    {
        role: "Software Engineer",
        company: "DTI Digital",
        companyUrl: "https://www.dtidigital.com.br/en",
        description:
            "Built a whitelabel e-commerce platform for Brazil's largest wholesale company. Worked full-stack with React and NestJS, and led frontend code reviews for the team.",
        from: "July 2021",
        to: "Jan 2022",
        skills: ["React", "TypeScript", "PostgreSQL", "NestJS"],
    },
    {
        role: "Software Engineer",
        company: "Vallourec",
        companyUrl: "https://www.vallourec.com/",
        description:
            "Maintained and enhanced a production site traceability system. Worked with on-site teams to design and implement new features, and participated in large-scale testing with thousands of tubes.",
        from: "Jan 2021",
        to: "July 2021",
        skills: ["C#", ".NET", "PostgreSQL"],
    },
    {
        role: "Software Engineer Intern",
        company: "Vallourec",
        companyUrl: "https://www.vallourec.com/",
        description:
            "My first software role. Worked on legacy traceability systems, handling the full development lifecycle from coding to deployment using C# and Windows Forms.",
        from: "Feb 2020",
        to: "Jan 2021",
        skills: ["C#", ".NET", "PostgreSQL"],
    },
];
---

<Layout
    title="Experience | Arthur Rodolfo"
    description="The personal site of Arthur Rodolfo">
    <section aria-label="Work experience">
        <ol class="group/list flex flex-col gap-6 lg:mx-auto lg:w-3/4">
            {
                experiences.map((experience, idx) => {
                    return (
                        <>
                            <li class="lg:hidden">
                                <ExperienceTileMobile {...experience} />
                            </li>
                            <li class="hidden lg:list-item">
                                <ExperienceTile
                                    {...experience}
                                    showLine={idx < experiences.length - 1}
                                />
                            </li>
                        </>
                    );
                })
            }
        </ol>

        <Link
            classes="text-xs mt-6 lg:mt-0 underline lg:float-right"
            href="/arthur-rodolfo-resume.pdf"
            text="View Full Resume">
            <OpenInNewTabIcon />
        </Link>
    </section>
</Layout>
