---
import Layout from "../layouts/Layout.astro";

import { t } from "../lib/strings";

---

<Layout
    title="Not Found | Arthur Rodolfo"
    description="404 Error — this page was not found">
    <div class="mx-auto flex h-full flex-col items-center justify-center gap-2">
        <h1 class="text-3xl font-bold">{t("404.title")}</h1>
        <p class="text-sm">
            {t("404.description")}
            {" "}
            <span class="font-bold" data-requested-path></span>
        </p>
        {/* This page is prerendered, so Astro.url.pathname here is the 404
            page's own path, never the URL the visitor actually asked for. */}
        <script is:inline>
            (function () {
                var el = document.querySelector("[data-requested-path]");
                if (el) el.textContent = window.location.pathname + ".";
            })();
        </script>
    </div>
</Layout>
