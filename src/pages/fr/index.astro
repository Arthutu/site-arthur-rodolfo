---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import arthurPicture from "../../assets/arthur.jpg";
---

<Layout
    title="Arthur Rodolfo"
    description="Ingénieur logiciel basé à Vancouver, construisant des produits avec soin et précision">
    <section
        class="mx-auto max-w-3xl flex flex-col gap-8 lg:gap-12 min-h-[calc(100vh-12rem)] justify-center"
        aria-label="Présentation d'Arthur Rodolfo">
        <div class="flex flex-col lg:flex-row items-center lg:items-start gap-8">
            <Image
                class="w-32 h-32 lg:w-40 lg:h-40 rounded-full object-cover shadow-lg"
                src={arthurPicture}
                alt="Arthur Rodolfo"
                loading="eager"
            />

            <div class="flex-1 flex flex-col gap-4">
                <div>
                    <h1 class="text-4xl lg:text-5xl font-bold mb-2">
                        Arthur Rodolfo
                    </h1>
                    <p class="text-xl lg:text-2xl text-slate-600 dark:text-slate-400">
                        Ingénieur Logiciel
                    </p>
                </div>

                <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
                    Salut! Je suis un ingénieur logiciel du Brésil <Icon
                        name="twemoji:flag-for-brazil"
                        class="inline-block h-5 w-5"
                    /> actuellement basé à Vancouver <Icon
                        name="twemoji:flag-for-canada"
                        class="inline-block h-5 w-5"
                    />. Je construis des applications web avec un accent sur le code propre et les excellentes expériences utilisateur, en utilisant des outils d'IA pour livrer plus vite.
                </p>

                <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
                    Actuellement, je travaille chez <a href="https://www.clio.com/" target="_blank" rel="noopener noreferrer" class="font-medium underline decoration-2 underline-offset-2 hover:text-slate-900 dark:hover:text-white transition-colors">Clio</a> dans l'équipe Platform, aidant à intégrer les produits dans une plateforme unifiée. Auparavant, j'ai travaillé avec des entreprises comme Hubly, BTG Pactual et d'autres, construisant tout, des systèmes e-commerce aux outils de surveillance financière.
                </p>

                <a 
                    href="mailto:arthurrodolfo81@gmail.com" 
                    class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-lg font-medium hover:bg-slate-700 dark:hover:bg-slate-200 transition-colors w-fit"
                >
                    <Icon name="mdi:email-outline" class="w-5 h-5" />
                    Discutons
                </a>
            </div>
        </div>
    </section>
</Layout>
