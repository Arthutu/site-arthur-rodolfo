---
import { t } from "../lib/strings";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
    <a class="site-footer__mark" href="/" aria-label={t("nav.homeLabel")}>AR</a>

    <nav aria-label={t("nav.footer")}>
        <a href="/about">{t("nav.about")}</a>
        <a href="/experience">{t("nav.experience")}</a>
        <a href="mailto:arthurrodolfo81@gmail.com">
            {t("nav.contact")} <span aria-hidden="true">↗</span>
        </a>
    </nav>

    <p>Vancouver, Canada · © {currentYear}</p>
</footer>

<style>
    .site-footer {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: end;
        gap: 2rem;
        padding: 2.5rem clamp(1.25rem, 4vw, 4rem);
        border-top: 1px solid rgba(240, 238, 232, 0.16);
        background: var(--ink);
        color: var(--paper);
    }

    .site-footer__mark {
        width: fit-content;
        color: inherit;
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        text-decoration: none;
    }

    nav {
        display: flex;
        gap: clamp(1rem, 2.5vw, 2.5rem);
    }

    nav a {
        color: inherit;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
    }

    nav a:hover,
    nav a:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.35rem;
    }

    p {
        justify-self: end;
        margin: 0;
        color: var(--muted);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    @media (max-width: 760px) {
        .site-footer {
            grid-template-columns: 1fr;
            align-items: start;
            padding-block: 2rem;
        }

        nav {
            flex-wrap: wrap;
        }

        p {
            justify-self: start;
        }
    }
</style>
