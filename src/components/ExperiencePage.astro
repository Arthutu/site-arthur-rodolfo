---
import EditorialContact from "./EditorialContact.astro";
import CinematicPageHero from "./CinematicPageHero.astro";
import experienceHero from "../assets/arthur-experience-hero.webp";
import { t } from "../lib/strings";

const shared = {
    companies: [
        { company: "Clio", url: "https://www.clio.com/", start: "2025-07", end: null, skills: ["Platform", "Event-driven systems", "Ruby on Rails"] },
        { company: "Hubly", url: "https://www.myhubly.com/", start: "2022-07", end: "2025-06", skills: ["Product engineering", "React", "Django", "AWS"] },
        { company: "BTG Pactual", url: "https://www.btgpactual.com/us/", start: "2022-01", end: "2022-07", skills: ["Fintech", "Event-driven systems", "Angular", ".NET"] },
        { company: "dti digital", url: "https://www.dtidigital.com.br/en", start: "2021-07", end: "2022-01", skills: ["Consulting", "React", "NestJS", "PostgreSQL"] },
        { company: "Vallourec", url: "https://www.vallourec.com/", start: "2021-01", end: "2021-07", skills: ["Industrial systems", "C#", ".NET", "PostgreSQL"] },
        { company: "Vallourec", url: "https://www.vallourec.com/", start: "2020-02", end: "2021-01", skills: ["Production software", "C#", "Windows Forms"] },
    ],
};

const c = {
    page: "Experience",
    title: "Every job got bigger than the last.",
    intro: "Industrial software in Brazil, then consulting, fintech, a Canadian startup, and now platform work at Clio. Each move traded comfort for scope.",
    present: "Present",
    roles: [
        { role: "Software Engineer", description: "Build event-driven platform services that keep core business data consistent across Clio products. Partner with Product, Design, and engineering teams in the data platform group to improve interoperability, reliability, and the developer experience." },
        { role: "Software Engineer", description: "Owned customer-facing features from discovery through production across onboarding, configurable forms, workflow automation, and partner distribution. Worked across product, design, backend, frontend, and cloud infrastructure." },
        { role: "Software Engineer", description: "Built an internal platform for monitoring financial transactions and improving operational traceability. Redesigned the operators’ workflow with the people who used it daily, and implemented reliable event-driven communication with AWS messaging services." },
        { role: "Software Engineer", description: "Delivered full-stack features for a white-label commerce platform serving a major Brazilian wholesale business. Contributed across product delivery, frontend architecture, backend services, and team code quality." },
        { role: "Software Engineer", description: "Maintained and evolved production traceability software supporting critical manufacturing operations. Worked directly with on-site teams to design features, validate behavior at industrial scale, and keep the system reliable." },
        { role: "Software Engineering Intern", description: "Started my software career owning practical internal applications from implementation through testing, deployment, and maintenance in a production manufacturing environment." },
    ],
} as const;

const monthFormatter = new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" });
const formatDate = (date: string) => monthFormatter.format(new Date(`${date}-01T00:00:00Z`)).replace(" de ", " ");
const experiences = shared.companies.map((company, index) => ({ ...company, ...c.roles[index] }));
---

<div class="experience-page-shell" data-inner-page>
    <CinematicPageHero page={c.page} statement={c.title} intro={c.intro} image={experienceHero} imagePosition="50% 43%" />

    <main id="main-content" class="experience-page">
    <section class="experience-list" aria-labelledby="experience-list-title" data-header-theme="light">
        <h2 id="experience-list-title" class="sr-only">{c.page}</h2>

        <div class="timeline">
            <span class="timeline-track" aria-hidden="true"></span>
            <span class="timeline-fill" aria-hidden="true" data-timeline-fill></span>
            <ol>
            {experiences.map((experience, index) => (
                <li data-reveal data-role>
                    <span class="timeline-node" aria-hidden="true"></span>
                    <article>
                        <div class="experience-index">0{index + 1}</div>
                        <div class="experience-time">
                            <time datetime={experience.start}>{formatDate(experience.start)}</time>
                            {/* A hidden dash read as nothing, so ranges announced
                                as "Jul 2025 Present" with no relation between them. */}
                            <span aria-hidden="true">—</span>
                            <span class="sr-only">{t("a11y.dateTo")}</span>
                            {experience.end ? <time datetime={experience.end}>{formatDate(experience.end)}</time> : <span>{c.present}</span>}
                        </div>
                        <div class="experience-content">
                            <h3>{experience.role}</h3>
                            <a href={experience.url} target="_blank" rel="noopener noreferrer">{experience.company}<span aria-hidden="true">↗</span></a>
                            <p>{experience.description}</p>
                            <ul aria-label={`${experience.company} — ${t("a11y.capabilities")}`}>
                                {experience.skills.map((skill) => <li>{skill}</li>)}
                            </ul>
                        </div>
                    </article>
                </li>
            ))}
            </ol>
        </div>

    </section>

    <EditorialContact />
    </main>
</div>

<script>
    import { onScroll } from "../scripts/scroll";

    // Grow the career progress line as the reading position descends the list.
    const timeline = document.querySelector<HTMLElement>(".timeline");
    const fill = timeline?.querySelector<HTMLElement>("[data-timeline-fill]");

    if (timeline && fill) {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            // Still show the completed line — it carries meaning — just don't
            // drive it from scroll.
            timeline.style.setProperty("--timeline-progress", "1");
        } else {
            onScroll(() => {
                const rect = timeline.getBoundingClientRect();
                const readingLine = window.innerHeight * 0.55;
                const progress = Math.max(0, Math.min(1, (readingLine - rect.top) / rect.height));
                timeline.style.setProperty("--timeline-progress", progress.toFixed(4));
            }, timeline);
        }
    }
</script>

<style>
    .experience-page-shell {
        overflow: clip;
        background: var(--ink);
    }

    .experience-page {
        background: var(--ink);
        color: var(--paper);
    }

    .experience-page-shell[data-motion="ready"] [data-reveal] {
        opacity: 0.48;
        transform: translateY(2rem);
        transition: opacity 800ms ease, transform 950ms var(--ease-cinematic);
    }

    .experience-page-shell[data-motion="ready"] [data-reveal][data-visible="true"] {
        opacity: 1;
        transform: translateY(0);
    }

    /* Each role stays dim until it reaches the reading position. */
    .experience-page-shell[data-motion="ready"] li[data-role] {
        opacity: 0.32;
        transform: translateY(2.5rem);
        transition: opacity 900ms ease, transform 1000ms var(--ease-cinematic);
    }

    .experience-page-shell[data-motion="ready"] li[data-role][data-visible="true"] {
        opacity: 1;
        transform: translateY(0);
    }

    /* Company, dates and description enter in a controlled sequence. */
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-index,
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-time,
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-content h3,
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-content > a,
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-content > p,
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-content ul {
        opacity: 0;
        transform: translateY(1.15rem);
        transition:
            opacity 700ms ease,
            transform 850ms var(--ease-cinematic);
    }

    .experience-page-shell[data-motion="ready"] li[data-role][data-visible="true"] :is(
        .experience-index,
        .experience-time,
        .experience-content h3,
        .experience-content > a,
        .experience-content > p,
        .experience-content ul
    ) {
        opacity: 1;
        transform: translateY(0);
    }

    .experience-page-shell[data-motion="ready"] li[data-role] .experience-time { transition-delay: 70ms; }
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-content h3 { transition-delay: 130ms; }
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-content > a { transition-delay: 210ms; }
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-content > p { transition-delay: 290ms; }
    .experience-page-shell[data-motion="ready"] li[data-role] .experience-content ul { transition-delay: 370ms; }

    .experience-list {
        /* Smaller top now that the "01 / The work" label is gone; the roomy
           bottom stays so the list breathes before the contact section. */
        padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 5vw, 5.5rem) clamp(6rem, 11vw, 11rem);
    }

    .page-label {
        display: flex;
        justify-content: space-between;
        padding-bottom: 1.35rem;
        border-bottom: 1px solid currentColor;
        color: var(--muted);
        font-size: 0.68rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .experience-list {
        background: var(--paper);
        color: var(--ink);
    }

    .experience-list .page-label {
        color: #66645f;
    }

    .timeline {
        --gutter: clamp(1.75rem, 4vw, 3rem);
        --rail: calc(var(--gutter) * 0.45);
        position: relative;
        margin: clamp(1rem, 2vw, 1.75rem) 0 0;
    }

    /* Persistent progress line connecting the career chapters. */
    .timeline-track,
    .timeline-fill {
        position: absolute;
        top: 0;
        left: var(--rail);
        width: 1px;
    }

    .timeline-track {
        bottom: 0;
        background: rgba(10, 10, 9, 0.18);
    }

    .timeline-fill {
        height: 100%;
        background: var(--accent);
        transform-origin: top;
        transform: scaleY(var(--timeline-progress, 0));
    }

    .timeline > ol {
        margin: 0;
        padding: 0 0 0 var(--gutter);
        list-style: none;
    }

    .timeline > ol > li {
        position: relative;
        border-bottom: 1px solid rgba(10, 10, 9, 0.2);
    }

    .timeline-node {
        position: absolute;
        top: calc(clamp(2.5rem, 5vw, 5rem) + 0.15rem);
        left: calc(var(--rail) - var(--gutter) - 0.31rem);
        width: 0.62rem;
        height: 0.62rem;
        border-radius: 50%;
        border: 1px solid rgba(10, 10, 9, 0.3);
        background: #d8d5cd;
        transform: scale(0.72);
        transition:
            transform 550ms var(--ease-cinematic),
            background 550ms ease,
            box-shadow 550ms ease;
    }

    .timeline > ol > li[data-visible="true"] .timeline-node {
        background: var(--accent);
        box-shadow: 0 0 0 5px rgba(210, 255, 63, 0.16);
        transform: scale(1);
    }

    article {
        display: grid;
        grid-template-columns: 3rem minmax(10rem, 0.45fr) minmax(24rem, 1fr);
        gap: clamp(1.5rem, 4vw, 4rem);
        padding: clamp(2.5rem, 5vw, 5rem) 0;
    }

    .experience-index,
    .experience-time {
        color: #66645f;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .experience-time {
        display: flex;
        gap: 0.45rem;
    }

    .experience-content h3 {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 5.3vw, 6rem);
        font-weight: 560;
        line-height: 0.92;
        letter-spacing: -0.04em;
    }

    .experience-content > a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        gap: 0.35rem;
        margin-top: 0.45rem;
        color: inherit;
        font-size: clamp(1rem, 1.35vw, 1.25rem);
        font-weight: 650;
        /* Underline is hover-revealed via colour (paint-only) at a fixed
           offset. Animating the offset or toggling the line grew the inline
           box and reflowed the description below it. */
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.25em;
        text-decoration-color: transparent;
        transition: text-decoration-color 250ms var(--ease-cinematic);
    }

    .experience-content > a:hover,
    .experience-content > a:focus-visible {
        text-decoration-color: currentColor;
    }

    .experience-content > p {
        max-width: 48rem;
        margin: clamp(2rem, 4vw, 3.5rem) 0;
        color: #53514d;
        font-size: clamp(1.05rem, 1.45vw, 1.3rem);
        line-height: 1.55;
    }

    .experience-content ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .experience-content ul li {
        padding: 0.45rem 0.75rem;
        border: 1px solid rgba(10, 10, 9, 0.28);
        border-radius: 999px;
        font-size: 0.72rem;
        letter-spacing: 0.03em;
    }



    @media (max-width: 760px) {
        article {
            grid-template-columns: 2rem 1fr;
            gap: 1rem;
        }

        .experience-time,
        .experience-content {
            grid-column: 2;
        }

        .experience-time {
            grid-row: 1;
            justify-content: flex-start;
        }

        .experience-content h3 {
            font-size: clamp(2.5rem, 12vw, 4.5rem);
        }

        .experience-content > p {
            text-align: left;
        }
    }
</style>
