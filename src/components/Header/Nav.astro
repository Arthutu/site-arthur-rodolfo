---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems: Array<{ href: string; text: string }> = [
    { href: `/${lang}`, text: t("nav.home") },
    { href: `/${lang}/about`, text: t("nav.about") },
    {
        href: `/${lang}/experience`,
        text: t("nav.experience"),
    },
    {
        href: `/${lang}/projects`,
        text: t("nav.projects"),
    },
];
---

<nav>
    <ul class="flex justify-center gap-6 text-xs md:text-lg lg:text-lg">
        {
            navItems.map(({ href, text }) => {
                return (
                    <li>
                        <a
                            href={href}
                            aria-current={Astro.url.pathname === href}
                            class:list={[
                                Astro.url.pathname === href
                                    ? [
                                          "border-b-2 border-neutral-900 dark:border-neutral-100",
                                      ]
                                    : [
                                          "text-neutral-600 hover:border-b-2 hover:border-neutral-400 dark:text-neutral-400 hover:dark:border-neutral-600 transition-colors",
                                      ],
                            ]}>
                            {text}
                        </a>
                    </li>
                );
            })
        }
    </ul>
</nav>
