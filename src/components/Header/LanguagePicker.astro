---
import { languages } from "../../i18n/ui";
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<label>
    <span class="sr-only">Language Selector</span>
    <select
        name="languages"
        id="language-select"
        class="rounded-lg border-2 border-indigo-200 p-0.5 text-xs lg:p-1 dark:border-neutral-800 dark:bg-neutral-950 dark:text-white">
        {
            Object.entries(languages).map(([code, name]) => {
                return (
                    <option value={code} selected={lang === code}>
                        {name}
                    </option>
                );
            })
        }
    </select>
</label>

<script>
    const select = document.querySelector(
        "#language-select"
    ) as HTMLSelectElement;

    select.addEventListener("change", (event) => {
        const newLang = (event.target as HTMLSelectElement).value;

        const [, , ...rest] = window.location.pathname.split("/");

        const slug = rest.join("/");

        window.location.pathname = `/${newLang}${
            slug.length === 0 ? "" : "/" + slug
        }`;
    });
</script>
