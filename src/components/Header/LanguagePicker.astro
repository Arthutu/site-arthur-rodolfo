---
import { languages } from "../../i18n/ui";
import { getLangFromUrl } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<label class="language-picker">
    <span class="sr-only">{t("nav.language")}</span>
    <select
        name="languages"
        id="language-select"
        aria-label={t("nav.language")}>
        {
            Object.entries(languages).map(([code, name]) => {
                return (
                    <option value={code} selected={lang === code}>
                        {name}
                    </option>
                );
            })
        }
    </select>
</label>

<style>
    .language-picker {
        display: inline-flex;
        align-items: center;
    }

    select {
        min-height: 2.75rem;
        padding: 0 1.6rem 0 0.5rem;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: 0.67rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        cursor: pointer;
    }

    select:focus-visible {
        outline: 1px solid currentColor;
        outline-offset: 2px;
    }

    @media (max-width: 760px) {
        .language-picker {
            margin-top: 2rem;
        }

        select {
            min-width: 12rem;
            border: 1px solid rgba(10, 10, 9, 0.34);
            padding: 0 2.5rem 0 0.9rem;
            font-size: 0.72rem;
        }
    }
</style>

<script>
    const select = document.querySelector(
        "#language-select"
    ) as HTMLSelectElement;

    select.addEventListener("change", (event) => {
        const newLang = (event.target as HTMLSelectElement).value;

        const [, , ...rest] = window.location.pathname.split("/");

        const slug = rest.join("/");

        window.location.pathname = `/${newLang}${
            slug.length === 0 ? "" : "/" + slug
        }`;
    });
</script>
