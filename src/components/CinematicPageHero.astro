---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    page: string;
    statement: string;
    intro: string;
    enterLabel: string;
    image: ImageMetadata;
    imagePosition?: string;
}

const { page, statement, intro, enterLabel, image, imagePosition = "50% 40%" } = Astro.props;
---

<div class="inner-hero" data-inner-hero style={`--inner-hero-position: ${imagePosition}`}>
    <section class="inner-hero-stage" aria-labelledby="inner-page-title" data-header-theme="dark">
        <div class="inner-hero-media" aria-hidden="true" data-inner-hero-media>
            <Image
                src={image}
                alt=""
                widths={[640, 960, 1280]}
                sizes="100vw"
                loading="eager"
                fetchpriority="high"
                class="inner-hero-photo"
            />
            <div class="inner-hero-vignette"></div>
        </div>

        <div class="inner-hero-grid" aria-hidden="true"></div>

        <div class="inner-hero-meta" data-inner-hero-copy>
            <span>Arthur Rodolfo / {page}</span>
            <span>49.2827° N / 123.1207° W</span>
        </div>

        <h1 id="inner-page-title" data-inner-hero-title>{page}</h1>

        <div class="inner-hero-intro" data-inner-hero-copy>
            <p>{statement}</p>
            <p>{intro}</p>
        </div>

        <a class="inner-hero-enter" href="#main-content" data-inner-hero-copy>
            <span>{enterLabel}</span>
            <span aria-hidden="true"></span>
        </a>
    </section>
</div>

<script>
    document.querySelectorAll<HTMLElement>("[data-inner-hero]").forEach((heroShell) => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const stage = heroShell.querySelector<HTMLElement>(".inner-hero-stage");
        const media = heroShell.querySelector<HTMLElement>("[data-inner-hero-media]");
        const title = heroShell.querySelector<HTMLElement>("[data-inner-hero-title]");
        const copy = heroShell.querySelectorAll<HTMLElement>("[data-inner-hero-copy]");
        let ticking = false;

        heroShell.setAttribute("data-motion", "ready");
        heroShell.closest<HTMLElement>("[data-inner-page]")?.setAttribute("data-motion", "ready");

        const update = () => {
            if (!stage || !media || !title) return;

            const rect = heroShell.getBoundingClientRect();
            const available = Math.max(1, heroShell.offsetHeight - window.innerHeight);
            const progress = Math.min(1, Math.max(0, -rect.top / available));
            const reveal = Math.min(1, progress * 1.5);
            const mobile = window.innerWidth <= 760;

            media.style.opacity = String(0.25 + reveal * 0.7);
            media.style.clipPath = `inset(${(1 - reveal) * 36}% ${(1 - reveal) * (mobile ? 7 : 20)}%)`;
            media.style.transform = `scale(${1.14 - reveal * 0.14})`;
            title.style.transform = `translate3d(0, ${-progress * (mobile ? 8 : 14)}vh, 0)`;
            copy.forEach((element) => {
                element.style.opacity = String(Math.max(0, 1 - progress * 2.15));
            });

            ticking = false;
        };

        const requestUpdate = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
        };

        window.addEventListener("scroll", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate, { passive: true });
        update();
    });

    const revealObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.setAttribute("data-visible", "true");
                revealObserver.unobserve(entry.target);
            });
        },
        { threshold: 0.12 }
    );

    document.querySelectorAll("[data-inner-page] [data-reveal]").forEach((section) => revealObserver.observe(section));
</script>

<style>
    .inner-hero {
        height: 165svh;
        background: #0a0a09;
        color: #f0eee8;
    }

    .inner-hero-stage {
        position: sticky;
        top: 0;
        height: 100svh;
        min-height: 40rem;
        overflow: hidden;
        isolation: isolate;
    }

    .inner-hero-media {
        position: absolute;
        inset: 0;
        z-index: -3;
        opacity: 0.95;
        clip-path: inset(0);
        filter: saturate(0.68) contrast(1.07);
        will-change: clip-path, opacity, transform;
    }

    [data-motion="ready"] .inner-hero-media {
        opacity: 0.25;
        clip-path: inset(36% 20%);
        transform: scale(1.14);
    }

    .inner-hero-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: var(--inner-hero-position);
    }

    .inner-hero-vignette {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(180deg, rgba(8, 8, 7, 0.68), transparent 30%, rgba(8, 8, 7, 0.48)),
            linear-gradient(90deg, rgba(8, 8, 7, 0.38), transparent 48%, rgba(8, 8, 7, 0.18));
    }

    .inner-hero-grid {
        position: absolute;
        inset: 0;
        z-index: -2;
        background-image:
            linear-gradient(rgba(240, 238, 232, 0.17) 1px, transparent 1px),
            linear-gradient(90deg, rgba(240, 238, 232, 0.17) 1px, transparent 1px);
        background-size: 100% 25%, 25% 100%;
        mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.82), transparent 92%);
        opacity: 0.34;
    }

    .inner-hero-meta {
        position: absolute;
        top: 6.75rem;
        right: clamp(1.25rem, 3vw, 3rem);
        left: clamp(1.25rem, 3vw, 3rem);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.65rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    h1 {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0 clamp(1rem, 2.25vw, 2.75rem);
        overflow-wrap: break-word;
        color: #f0eee8;
        font-size: clamp(4.2rem, 14vw, 15rem);
        font-weight: 740;
        line-height: 0.72;
        letter-spacing: -0.087em;
        text-transform: uppercase;
        text-wrap: balance;
        pointer-events: none;
        will-change: transform;
    }

    .inner-hero-intro {
        position: absolute;
        right: clamp(1.25rem, 3vw, 3rem);
        bottom: clamp(5rem, 10vh, 8rem);
        width: min(34rem, 47vw);
    }

    .inner-hero-intro p:first-child {
        margin: 0 0 0.8rem;
        color: #d2ff3f;
        font-size: clamp(1.3rem, 2.25vw, 2.35rem);
        font-weight: 560;
        line-height: 1.02;
        letter-spacing: -0.045em;
    }

    .inner-hero-intro p:last-child {
        margin: 0;
        color: #d0cec7;
        font-size: clamp(1rem, 1.25vw, 1.2rem);
        line-height: 1.45;
    }

    .inner-hero-enter {
        position: absolute;
        bottom: 2.25rem;
        left: clamp(1.25rem, 3vw, 3rem);
        display: flex;
        min-height: 2.75rem;
        align-items: center;
        gap: 0.9rem;
        color: inherit;
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-decoration: none;
        text-transform: uppercase;
    }

    .inner-hero-enter span:last-child {
        width: 4rem;
        height: 1px;
        background: currentColor;
        transform-origin: left;
        animation: inner-scan 2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @keyframes inner-scan {
        0%, 100% { transform: scaleX(0.18); opacity: 0.45; }
        50% { transform: scaleX(1); opacity: 1; }
    }

    @media (max-width: 760px) {
        .inner-hero {
            height: 150svh;
        }

        .inner-hero-stage {
            min-height: 34rem;
        }

        [data-motion="ready"] .inner-hero-media {
            clip-path: inset(36% 7%);
        }

        .inner-hero-meta {
            top: 5.75rem;
        }

        .inner-hero-meta span:last-child {
            display: none;
        }

        h1 {
            align-items: flex-start;
            padding-top: 34svh;
            font-size: clamp(3.4rem, 14vw, 6rem);
            line-height: 0.8;
        }

        .inner-hero-intro {
            right: 1.25rem;
            bottom: 5.5rem;
            left: 1.25rem;
            width: auto;
        }

        .inner-hero-intro p:first-child {
            max-width: 15ch;
            font-size: clamp(1.5rem, 7vw, 2rem);
        }

        .inner-hero-intro p:last-child {
            max-width: 34rem;
            font-size: 1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .inner-hero {
            height: 100svh;
        }

        .inner-hero-enter span:last-child {
            animation: none;
        }
    }
</style>
