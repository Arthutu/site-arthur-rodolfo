---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    page: string;
    statement?: string;
    intro: string;
    image: ImageMetadata;
    imagePosition?: string;
}

const { page, statement, intro, image, imagePosition = "50% 40%" } = Astro.props;
---

<div class="inner-hero" data-inner-hero style={`--inner-hero-position: ${imagePosition}`}>
    <section class="inner-hero-stage" aria-labelledby="inner-page-title" data-header-theme="dark">
        <div class="inner-hero-media" aria-hidden="true" data-inner-hero-media>
            <Image
                src={image}
                alt=""
                widths={[640, 960, 1280, 1920, 2560]}
                quality={90}
                sizes="100vw"
                loading="eager"
                fetchpriority="high"
                class="inner-hero-photo"
            />
            <div class="inner-hero-vignette"></div>
        </div>

        <div class="inner-hero-grid" aria-hidden="true"></div>

        <h1 id="inner-page-title" data-inner-hero-title>{page}</h1>

        <div class="inner-hero-intro" data-inner-hero-copy>
            {statement && <p class="inner-hero-statement">{statement}</p>}
            <p class="inner-hero-lede">{intro}</p>
        </div>
    </section>
</div>

<script>
    document.querySelectorAll<HTMLElement>("[data-inner-hero]").forEach((heroShell) => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const stage = heroShell.querySelector<HTMLElement>(".inner-hero-stage");
        const media = heroShell.querySelector<HTMLElement>("[data-inner-hero-media]");
        const title = heroShell.querySelector<HTMLElement>("[data-inner-hero-title]");
        const copy = heroShell.querySelectorAll<HTMLElement>("[data-inner-hero-copy]");
        let ticking = false;

        heroShell.setAttribute("data-motion", "ready");
        heroShell.closest<HTMLElement>("[data-inner-page]")?.setAttribute("data-motion", "ready");

        let lastProgress = -1;

        const update = () => {
            if (!stage || !media || !title) return;

            const rect = heroShell.getBoundingClientRect();
            const available = Math.max(1, heroShell.offsetHeight - window.innerHeight);
            const progress = Math.min(1, Math.max(0, -rect.top / available));

            // Once scrolled past, every write below is identical — stop paying
            // for them for the rest of the page.
            if (progress === 1 && lastProgress === 1) {
                ticking = false;
                return;
            }
            lastProgress = progress;

            const reveal = Math.min(1, progress * 1.5);
            const mobile = window.innerWidth <= 760;

            // Starts fully hidden and emerges with the expanding frame, matching
            // the home hero. Starting at 0.25 left a clipped rectangle with hard
            // edges visible before any scrolling happened.
            media.style.opacity = String(reveal * 0.95);
            media.style.clipPath = `inset(${(1 - reveal) * 36}% ${(1 - reveal) * (mobile ? 7 : 20)}%)`;
            media.style.transform = `scale(${1.14 - reveal * 0.14})`;
            title.style.transform = `translate3d(0, ${-progress * (mobile ? 8 : 14)}vh, 0)`;
            const copyOpacity = Math.max(0, 1 - progress * 2.15);
            copy.forEach((element) => {
                element.style.opacity = String(copyOpacity);
                // Keep faded controls out of the tab order.
                element.toggleAttribute("inert", copyOpacity < 0.05);
            });

            ticking = false;
        };

        const requestUpdate = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
        };

        window.addEventListener("scroll", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate, { passive: true });
        update();
    });

    const revealObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.setAttribute("data-visible", "true");
                revealObserver.unobserve(entry.target);
            });
        },
        { threshold: 0.12 }
    );

    document.querySelectorAll("[data-inner-page] [data-reveal]").forEach((section) => revealObserver.observe(section));
</script>

<style>
    .inner-hero {
        height: 165svh;
        background: var(--ink);
        color: var(--paper);
    }

    .inner-hero-stage {
        position: sticky;
        top: 0;
        height: 100svh;
        min-height: 40rem;
        overflow: hidden;
        isolation: isolate;
    }

    /* Resting state for no-JS and reduced motion: visible, but held back far
       enough that the intro copy keeps its contrast over bright areas of the
       photo. The scroll choreography below overrides it when motion runs. */
    .inner-hero-media {
        position: absolute;
        inset: 0;
        z-index: -3;
        opacity: 0.55;
        clip-path: inset(0);
        filter: saturate(0.68) contrast(1.07);
    }

    [data-motion="ready"] .inner-hero-media {
        opacity: 0;
        clip-path: inset(36% 20%);
        transform: scale(1.14);
    }

    .inner-hero-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: var(--inner-hero-position);
    }

    .inner-hero-vignette {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(180deg, rgba(8, 8, 7, 0.68), transparent 30%, rgba(8, 8, 7, 0.48)),
            linear-gradient(90deg, rgba(8, 8, 7, 0.38), transparent 48%, rgba(8, 8, 7, 0.18));
    }

    .inner-hero-grid {
        position: absolute;
        inset: 0;
        z-index: -2;
        background-image:
            linear-gradient(rgba(240, 238, 232, 0.17) 1px, transparent 1px),
            linear-gradient(90deg, rgba(240, 238, 232, 0.17) 1px, transparent 1px);
        background-size: 100% 25%, 25% 100%;
        mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.82), transparent 92%);
        opacity: 0.34;
    }

    .inner-hero-meta {
        position: absolute;
        top: 6.75rem;
        right: clamp(1.25rem, 3vw, 3rem);
        left: clamp(1.25rem, 3vw, 3rem);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.65rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    h1 {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0 clamp(1rem, 2.25vw, 2.75rem);
        overflow-wrap: break-word;
        color: var(--paper);
        font-family: var(--font-display);
        font-size: clamp(4.2rem, 14vw, 15rem);
        font-weight: 700;
        line-height: 0.78;
        letter-spacing: -0.055em;
        text-transform: uppercase;
        text-wrap: balance;
        pointer-events: none;
    }

    .inner-hero-intro {
        position: absolute;
        right: clamp(1.25rem, 3vw, 3rem);
        bottom: clamp(5rem, 10vh, 8rem);
        width: min(34rem, 47vw);
    }

    .inner-hero-statement {
        margin: 0 0 0.8rem;
        color: var(--accent);
        font-family: var(--font-display);
        font-size: clamp(1.3rem, 2.25vw, 2.35rem);
        font-weight: 560;
        text-wrap: balance;
        line-height: 1.08;
        letter-spacing: -0.03em;
    }

    .inner-hero-lede {
        margin: 0;
        color: #d0cec7;
        font-size: clamp(1rem, 1.25vw, 1.2rem);
        line-height: 1.45;
    }

    @media (max-width: 760px) {
        .inner-hero {
            height: 150svh;
        }

        .inner-hero-stage {
            min-height: 34rem;
        }

        [data-motion="ready"] .inner-hero-media {
            clip-path: inset(36% 7%);
        }

        .inner-hero-meta {
            top: 5.75rem;
        }

        .inner-hero-meta span:last-child {
            display: none;
        }

        h1 {
            align-items: flex-start;
            padding-top: 34svh;
            font-size: clamp(3.4rem, 14vw, 6rem);
            line-height: 0.8;
        }

        .inner-hero-intro {
            right: 1.25rem;
            bottom: 5.5rem;
            left: 1.25rem;
            width: auto;
        }

        .inner-hero-statement {
            max-width: 15ch;
            font-size: clamp(1.5rem, 7vw, 2rem);
        }

        .inner-hero-lede {
            max-width: 34rem;
            font-size: 1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .inner-hero {
            height: 100svh;
        }
    }
</style>
