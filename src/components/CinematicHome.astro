---

<div class="cinematic-home" data-home>
    <section class="hero" aria-labelledby="hero-title" data-hero data-header-theme="dark">
        <div class="hero-stage">
            <div class="hero-media" aria-hidden="true" data-hero-media>
                <Image
                    src={homeHero}
                    alt=""
                    widths={[640, 960, 1280]}
                    sizes="100vw"
                    loading="eager"
                    fetchpriority="high"
                    class="hero-photo"
                />
                <div class="hero-vignette"></div>
            </div>

            <div class="hero-grid" aria-hidden="true"></div>

            <div class="hero-meta" data-hero-copy>
                <p>{c.eyebrow}</p>
                <p>49.2827° N / 123.1207° W</p>
            </div>

            <h1 id="hero-title" class="hero-title" aria-label="Arthur Rodolfo">
                <span class="hero-line hero-line-first" data-name-line>Arthur</span>
                <span class="hero-line hero-line-second" data-name-line>Rodolfo</span>
            </h1>

            <div class="hero-intro" data-hero-copy>
                <p class="hero-kicker">{c.descriptor}.</p>
                <p>{c.intro}</p>
            </div>

            <a class="hero-scroll" href="#main-content" data-hero-copy>
                <span>{c.scroll}</span>
                <span class="scroll-line" aria-hidden="true"></span>
            </a>
        </div>
    </section>

    <main id="main-content">
        <section class="statement-section chapter" data-reveal data-header-theme="light">
            <div class="chapter-label">
                <span>{c.chapterOne}</span>
                <span aria-hidden="true">AR / 01</span>
            </div>

            <div class="statement-copy">
                <p class="statement-lead">{c.beliefLead}</p>
                <p>{c.belief}</p>
            </div>

            <p class="intro-detail">{c.introDetail}</p>

            <ol class="principles" aria-label="Working principles">
                <li><span>01</span>{c.principleOne}</li>
                <li><span>02</span>{c.principleTwo}</li>
                <li><span>03</span>{c.principleThree}</li>
            </ol>
        </section>

        <section class="work-section chapter" data-reveal data-header-theme="dark">
            <div class="chapter-label">
                <span>{c.chapterTwo}</span>
                <span aria-hidden="true">AR / 02</span>
            </div>

            <header class="work-header">
                <h2>{c.workTitle}</h2>
                <p>{c.workIntro}</p>
            </header>

            <ol class="disciplines">
                {c.work.map((item) => (
                    <li class="discipline" data-discipline>
                        <span class="discipline-index">{item.index}</span>
                        <h3>{item.title}</h3>
                        <p>{item.body}</p>
                        <span class="discipline-mark" aria-hidden="true">↗</span>
                    </li>
                ))}
            </ol>
        </section>

        <section class="trajectory-section chapter" data-reveal data-header-theme="dark">
            <div class="chapter-label trajectory-label">
                <span>{c.chapterThree}</span>
                <span aria-hidden="true">AR / 03</span>
            </div>

            <figure class="trajectory-media">
                <Image
                    src={personalLandscape}
                    alt={c.personalAlt}
                    widths={[640, 960, 1280, 1536]}
                    sizes="(max-width: 760px) 100vw, 90vw"
                    loading="lazy"
                    class="trajectory-photo"
                />
            </figure>

            <div class="trajectory-lines">
                <p>{c.origin}</p>
                <p>{c.present}</p>
                <p class="trajectory-highlight">{c.future}</p>
            </div>

            <p class="trajectory-detail">{c.futureDetail}</p>
        </section>

        <EditorialContact lang={lang} />
    </main>
</div>

<script>
    const home = document.querySelector<HTMLElement>("[data-home]");

    if (home && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        home.setAttribute("data-motion", "ready");
        const hero = home.querySelector<HTMLElement>("[data-hero]");
        const media = home.querySelector<HTMLElement>("[data-hero-media]");
        const nameLines = home.querySelectorAll<HTMLElement>("[data-name-line]");
        const heroCopy = home.querySelectorAll<HTMLElement>("[data-hero-copy]");

        let ticking = false;

        const updateHero = () => {
            if (!hero || !media) return;

            const rect = hero.getBoundingClientRect();
            const available = Math.max(1, hero.offsetHeight - window.innerHeight);
            const progress = Math.min(1, Math.max(0, -rect.top / available));
            const reveal = Math.min(1, progress * 1.45);
            const mobile = window.innerWidth <= 760;
            const horizontalInset = mobile ? 8 : 22;

            home.style.setProperty("--hero-progress", progress.toFixed(3));
            home.style.setProperty("--media-reveal", reveal.toFixed(3));
            media.style.opacity = String(reveal * 0.93);
            media.style.clipPath = `inset(${(1 - reveal) * 40}% ${(1 - reveal) * horizontalInset}%)`;
            media.style.transform = `scale(${1.16 - reveal * 0.16})`;

            nameLines.forEach((line, index) => {
                const direction = index === 0 ? -1 : 1;
                const horizontalTravel = mobile ? 2.5 : 9;
                const verticalTravel = mobile ? 10 : 16;
                line.style.transform = `translate3d(${direction * progress * horizontalTravel}vw, ${-progress * verticalTravel}vh, 0)`;
            });

            heroCopy.forEach((element) => {
                element.style.opacity = String(Math.max(0, 1 - progress * 2.2));
            });

            ticking = false;
        };

        const requestUpdate = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(updateHero);
        };

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.setAttribute("data-visible", "true");
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.16 }
        );

        home.querySelectorAll("[data-reveal], [data-discipline]").forEach((element) => observer.observe(element));
        window.addEventListener("scroll", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate, { passive: true });
        updateHero();
    }
</script>

<style>
    .cinematic-home {
        --ink: #0a0a09;
        --paper: #f0eee8;
        --paper-muted: #aaa79f;
        --line: rgba(240, 238, 232, 0.19);
        --accent: #d2ff3f;
        background: var(--ink);
        color: var(--paper);
        overflow: clip;
    }

    .hero {
        position: relative;
        height: 185svh;
        background: var(--ink);
    }

    .hero-stage {
        position: sticky;
        top: 0;
        height: 100svh;
        min-height: 42rem;
        overflow: hidden;
        isolation: isolate;
    }

    .hero-media {
        position: absolute;
        inset: 0;
        z-index: -3;
        opacity: 0;
        clip-path: inset(40% 22%);
        transform: scale(1.16);
        filter: saturate(0.72) contrast(1.04);
        will-change: clip-path, transform, opacity;
    }

    .hero-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 39%;
    }

    .hero-vignette {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(180deg, rgba(8, 8, 7, 0.62), transparent 32%, rgba(8, 8, 7, 0.28)),
            linear-gradient(90deg, rgba(8, 8, 7, 0.32), transparent 45%, rgba(8, 8, 7, 0.15));
    }

    .hero-grid {
        position: absolute;
        inset: 0;
        z-index: -2;
        background-image:
            linear-gradient(var(--line) 1px, transparent 1px),
            linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 100% 25%, 25% 100%;
        mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent 82%);
        opacity: 0.35;
    }

    .hero-meta {
        position: absolute;
        top: 6.75rem;
        left: clamp(1.25rem, 3vw, 3rem);
        right: clamp(1.25rem, 3vw, 3rem);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.65rem;
        line-height: 1;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        transition: opacity 100ms linear;
    }

    .hero-title {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        margin: 0;
        padding: 0 clamp(1rem, 2.25vw, 2.75rem);
        font-size: clamp(4.7rem, 16.9vw, 19rem);
        font-weight: 740;
        line-height: 0.71;
        letter-spacing: -0.087em;
        text-transform: uppercase;
        pointer-events: none;
    }

    .hero-line {
        display: block;
        will-change: transform;
    }

    .hero-line-second {
        align-self: flex-end;
        padding-right: 0.06em;
    }

    .hero-intro {
        position: absolute;
        right: clamp(1.25rem, 3vw, 3rem);
        bottom: clamp(5rem, 10vh, 8rem);
        width: min(27rem, 44vw);
        font-size: clamp(1.15rem, 1.65vw, 1.7rem);
        line-height: 1.18;
        letter-spacing: -0.025em;
        transition: opacity 100ms linear;
    }

    .hero-kicker {
        margin-bottom: 0.7rem;
        color: var(--accent);
        font-size: 0.66rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .hero-scroll {
        position: absolute;
        bottom: 2.25rem;
        left: clamp(1.25rem, 3vw, 3rem);
        display: flex;
        align-items: center;
        gap: 0.9rem;
        color: inherit;
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-decoration: none;
        text-transform: uppercase;
        transition: opacity 100ms linear;
    }

    .scroll-line {
        width: 4rem;
        height: 1px;
        background: currentColor;
        transform-origin: left;
        animation: scan 2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    .chapter {
        position: relative;
        padding: clamp(6rem, 13vw, 13rem) clamp(1.25rem, 5vw, 5.5rem);
    }

    .chapter-label {
        display: flex;
        justify-content: space-between;
        padding-bottom: 1.35rem;
        border-bottom: 1px solid var(--line);
        color: var(--paper-muted);
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .statement-section {
        min-height: 120svh;
        background: var(--paper);
        color: var(--ink);
    }

    .statement-section .chapter-label {
        border-color: rgba(10, 10, 9, 0.18);
        color: #66645f;
    }

    .statement-copy {
        width: min(72rem, 94%);
        margin: clamp(5rem, 12vw, 11rem) 0 0 auto;
        font-size: clamp(2.4rem, 6.5vw, 7.2rem);
        line-height: 0.98;
        letter-spacing: -0.065em;
    }

    .statement-lead {
        color: #99968f;
    }

    .intro-detail {
        width: min(34rem, 90%);
        margin: clamp(4rem, 9vw, 8rem) 0 0 auto;
        font-size: clamp(1.15rem, 1.8vw, 1.65rem);
        line-height: 1.45;
        letter-spacing: -0.025em;
    }

    .principles {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: clamp(5rem, 12vw, 11rem);
        padding: 0;
        border-top: 1px solid rgba(10, 10, 9, 0.18);
        list-style: none;
    }

    .principles li {
        display: flex;
        flex-direction: column;
        min-height: 10rem;
        padding: 1.2rem 1.1rem 1.2rem 0;
        border-right: 1px solid rgba(10, 10, 9, 0.18);
        font-size: clamp(1rem, 1.35vw, 1.3rem);
        line-height: 1.2;
    }

    .principles li + li {
        padding-left: 1.1rem;
    }

    .principles li:last-child {
        border: 0;
    }

    .principles span {
        margin-bottom: auto;
        color: #77746e;
        font-size: 0.65rem;
        letter-spacing: 0.15em;
    }

    .work-section {
        min-height: 140svh;
    }

    .work-header {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(15rem, 1fr);
        gap: 3rem;
        align-items: end;
        margin: clamp(5rem, 10vw, 9rem) 0;
    }

    .work-header h2 {
        max-width: 13ch;
        font-size: clamp(3.2rem, 8.2vw, 9rem);
        font-weight: 540;
        line-height: 0.88;
        letter-spacing: -0.07em;
    }

    .work-header p {
        max-width: 28rem;
        color: var(--paper-muted);
        font-size: clamp(1.05rem, 1.45vw, 1.4rem);
        line-height: 1.45;
    }

    .disciplines {
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--line);
        list-style: none;
    }

    .discipline {
        position: relative;
        display: grid;
        grid-template-columns: 4rem minmax(10rem, 0.85fr) minmax(18rem, 1fr) 2rem;
        gap: 2rem;
        align-items: start;
        padding: clamp(2rem, 4vw, 4rem) 0;
        border-bottom: 1px solid var(--line);
        opacity: 0.42;
        transform: translateY(1.25rem);
        transition: opacity 700ms ease, transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .discipline[data-visible="true"] {
        opacity: 1;
        transform: translateY(0);
    }

    .discipline-index {
        color: var(--paper-muted);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
    }

    .discipline h3 {
        font-size: clamp(2rem, 4vw, 4.6rem);
        font-weight: 520;
        line-height: 0.92;
        letter-spacing: -0.055em;
    }

    .discipline p {
        max-width: 35rem;
        color: var(--paper-muted);
        font-size: clamp(1rem, 1.35vw, 1.25rem);
        line-height: 1.45;
    }

    .discipline-mark {
        color: var(--accent);
        font-size: 1.2rem;
    }

    .trajectory-section {
        min-height: 118svh;
        background: #171714;
    }

    .trajectory-media {
        width: 100%;
        margin: clamp(3.5rem, 7vw, 7rem) 0 clamp(5rem, 10vw, 10rem);
