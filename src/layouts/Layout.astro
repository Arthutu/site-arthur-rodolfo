---
import Footer from "../components/Footer.astro";
import Header from "../components/Header/Header.astro";
import { getLangFromUrl } from "../i18n/utils";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    immersive?: boolean;
}

const { title, description, immersive = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const canonicalUrl = new URL(Astro.url.pathname, "https://www.arthurrodolfo.com");
---

<!doctype html>
<html lang={lang} class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            property="og:description"
            content={description}
        />

        <meta property="og:url" content="https://www.arthurrodolfo.com/" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="Arthur Rodolfo" />
        <meta
            name="og:image"
            content="https://www.arthurrodolfo.com/arthur.png"
        />

        <link rel="canonical" href={canonicalUrl} />
        <meta name="theme-color" content="#0a0a09" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:domain" content="arthurrodolfo.com" />
        <meta property="twitter:url" content="https://www.arthurrodolfo.com/" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content="https://www.arthurrodolfo.com/arthur.png"
        />
        <meta name="twitter:site" content="@arthurlrodolfo" />
        <meta name="twitter:creator" content="@arthurlrodolfo" />

        <meta name="generator" content={Astro.generator} />
        <meta name="viewport" content="width=device-width" />

        <meta name="author" content="Arthur Rodolfo" />
        <meta name="robots" content="index, follow" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body class:list={["site-body", { "immersive-page": immersive }]}>
        <Header />
        {
            immersive ? (
                <div class="immersive-content"><slot /></div>
            ) : (
                <main class="standard-content"><slot /></main>
            )
        }
        {!immersive && <Footer />}
    </body>
</html>

<style is:global>
    ::selection {
        background-color: var(--highlight-background-color);
        color: var(--highlight-color);
    }
</style>
